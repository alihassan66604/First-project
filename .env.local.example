# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Login & sessions (required) ---
# Random 32+ character secret used to sign session cookies.
# Generate one with:  node scripts/hash-password.mjs --secret
SESSION_SECRET=

# Password HASHES (not plain passwords) for the three built-in role accounts:
#   owner@seopilot.app, office@seopilot.app, user@seopilot.app
# Generate each with:  node scripts/hash-password.mjs "your-strong-password"
AUTH_OWNER_PASSWORD_HASH=
AUTH_OFFICE_PASSWORD_HASH=
AUTH_USER_PASSWORD_HASH=

# --- Supabase (optional until you connect the database) ---
# Free project keys: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
